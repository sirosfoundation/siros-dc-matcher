{
  "description": "Rulebook example: normative req shape, plain vp_formats_supported arrays.",
  "query": {
    "id": "nym_attestation",
    "format": "zkp_req",
    "meta": {
      "source_format": "mso_mdoc",
      "doctype_value": "eu.europa.ec.eudi.nym_auth.1"
    },
    "_req": [
      {
        "fn_id": "pseudonym",
        "return": "nym-123",
        "params": {
          "config": "known-offender-matching-ssc",
          "ver": 1,
          "prf": "sha-256"
        }
      },
      {
        "fn_id": "age_check",
        "return": "age-range-123",
        "params": {
          "range": "13-17"
        }
      }
    ]
  },
  "client_metadata": {
    "vp_formats_supported": {
      "zkp_req": {
        "system_id_values": [
          "urn:circuits:longfellow:nym_auth:v1"
        ],
        "proof_backend_values": [
          "longfellow-libzk-v1"
        ]
      }
    }
  },
  "expect": {
    "valid": {
      "options": [
        [
          0,
          1
        ]
      ],
      "req_sets": false
    }
  },
  "v0_4": "proof_system_values is proof_backend_values; age_check takes range (inputs migrated)."
}
